	// Extend the TCPDF class to create custom Header and Footer
	class MYPDF extends TCPDF {
    public function Header() {
			// FALTA: TOMAR EL LOGO DESDE LA EMPRESA => USAR COMO REFERENCIA LA IMPRESION DE FACTURA (SLSINV)
			//$this->Image('library/images/logos/supplysouth.jpg',20,8,32);
      $this->setCellPaddings(1, 1, 1, 1);
      // set cell margins
      $this->setCellMargins(0, 0, 0, 0);
      $this->setxy(20,40); 
      $this->Image('library/images/logos/supplysouth.jpg', $this->GetX()+2, $this->GetY()+4, 32);
      $this->MultiCell(38, 19,'', 1, 'C', 0, 0, '', '', true, 0, false, true, 0, 'M', true);
      $this->setfont('helvetica', 'B', 12);
      $this->MultiCell(68, 19, 'Colocación de materiales para certificación.', 1, 'C', 0, 0, '', '', true, 0, false, true, 0, 'M', true);
      $this->setfont('helvetica', '', 8);
      $this->SetFillColor(205, 205, 205);
      $this->MultiCell(48, 9.5, 'F-104-SS Rev.00', 1, 'C', 1, 0, '', '', true, 0, false, true, 0, 'M', true);
      $this->SetXY($this->GetX()-48, $this->GetY() + $this->getLastH());
      $this->MultiCell(48, 9.5, '             Página '.$this->getAliasNumPage().' de '.$this->getAliasNbPages(), 1, 'C', 1, 0, '', '', true, 0, false, true, 0, 'M', true);
      $this->Ln();
    }
		
    public function Footer() {
      
     }
	}

