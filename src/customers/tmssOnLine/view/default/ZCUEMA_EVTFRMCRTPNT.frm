<?php
  // Include the main TCPDF library (search for installation path).
  require_once('library/plugins/phptools/tcpdf/6.7.4/tcpdf.php');

	// Extend the TCPDF class to create custom Header and Footer
	class MYPDF extends TCPDF {
    public $lv_usrcod;
    public function Header() {
			// FALTA: TOMAR EL LOGO DESDE LA EMPRESA => USAR COMO REFERENCIA LA IMPRESION DE FACTURA (SLSINV)
			$lv_imgdattmp = base64_decode('');
      $lv_imgfletmp = tempnam(sys_get_temp_dir(), 'tcpdf') . '.png';
      file_put_contents($lv_imgfletmp, $lv_imgdattmp);
      
      $this->Image($lv_imgfletmp,20,5,25);
			$this->setfont('helvetica', 'B', 10);
      $this->setxy(20,23); $this->Cell(180, 5, 'PROPUESTA DE CERTIFICACION', 1, 0, 'C');
	
		}
		
    public function Footer() {
      $lv_imgdat = base64_decode('');
      $lv_imgfle = tempnam(sys_get_temp_dir(), 'tcpdf') . '.png';
      file_put_contents($lv_imgfle, $lv_imgdat);
      $this->SetY(-52);
			$this->Image($lv_imgfle, 40, $this->getY(), 24, 18, 'PNG', '', '', true, 150, '', false, false, 0, false, false, false);
      
      $this->SetFont('helvetica', 'B', 8);
      $this->SetY(-34);
			$this->text(40, $this->getY(), 'CONTRATISTA' );
			
			$this->text(149, $this->getY(), 'JEFE DEPARTAMENTO EDENOR' );
      
      $this->SetFont('courier', '', 9);
			$this->SetY(-30);
			$this->text(27, $this->getY(), 'Firma, aclaracion y Fecha' );
      
			$this->text(148, $this->getY(), 'Firma, aclaracion y Fecha' );

      $this->SetY(-14);
			$this->SetFont('helvetica', '', 8);
			$this->text(50, $this->getY(), 'NG2- ENCARGOS Y CONTRATISTAS - Fecha de Actualización 15/05/07 - Revisión Nº 9' );

      $this->SetY(-22);
			$this->SetFont('helvetica', '', 8);
			$this->text(180, $this->getY(), 'Pagina '.$this->getAliasNumPage().' de '.$this->getAliasNbPages() );
    }
	}

  function generarRotulo($pdf, $vew_ste, $vew_doc, $vew_bus, $vew_data) {
      // Obtengo unidad de negocio
      $lv_unttxt = '';
      foreach ($vew_ste->stecnt as $lv_rowcnt) {
          if ($lv_rowcnt['sysdocclscodext'] == 'UNT') {
              $lv_unttxt = $lv_rowcnt['cntdsttxt'];
              break;
          }
      }

      // Obtengo supervisor
      $lv_suptxt = '';
      foreach ($vew_ste->stecnt as $lv_rowcnt) {
          if ($lv_rowcnt['sysdocclscodext'] == 'SUP') {
              $lv_suptxt = $lv_rowcnt['cntdsttxt'];
              break;
          }
      }

      // Añadir textos al rótulo
      $pdf->setfont('helvetica', 'B', 9);
      $pdf->text(20, 35, 'ZONA:'); 
      $pdf->text(105, 35, 'SUPERVISOR:');
      $pdf->text(140, 35, $lv_suptxt);
      $pdf->text(32, 35, $vew_doc->getTagValue($vew_ste->cnssteatr, 'ATR_ZNA')); 
      $pdf->text(70, 35, $vew_doc->getTagValue($vew_ste->cnssteatr, 'ATR_SCT'));
    	
     // Formulario
      $lv_cmp[0] = array(
          'CONTRATISTA' => $vew_bus->bustxt,
          'DIRECCION' => $vew_bus->adr->adrstr.' '.$vew_bus->adr->adrstrnum,
        	'PARTIDO' => $vew_ste->adr->adrtwn, 
        	'LOCALIDAD' => $vew_ste->adr->adrcty,  
          'Nº DE LA OBRA' => $vew_ste->stecod 
      );
      $lv_cmp[1] = array(
          'Nº DE HOJA DE ENTRADA' => '',
          'Nº DE CERTIFICACION' => $vew_data->steevtcod,
          'FECHA CERTIFICACION' => $vew_data->steevtdte->format('d/m/Y')
      );
      $lv_cmp[2] = array(
          'CENTRO DE COSTO' => '',
          'Nº DE PEDIDO' => '',
          'PARTIDO' => '',
          'CUENTA DE APLICACIÓN' => ''
      );

      $y = 45;
      foreach ($lv_cmp[0] as $key => $value) {
          $pdf->SetFont('helvetica', '', 8);
          $pdf->SetXY(20, $y);
          $pdf->Cell(40, 5, $key, 1, 1, 'L', 0, '', 1);

          $pdf->SetFont('helvetica', 'B', 10);
          $pdf->SetXY(60, $y);
          $pdf->Cell(50, 5, $value, 1, 1, 'L', 0, '', 1);
          $y += 5;
      }

      $y = 45;
      foreach ($lv_cmp[1] as $key => $value) {
          $pdf->SetFont('helvetica', '', 8);
          $pdf->SetXY(112, $y);
          $pdf->Cell(40, 5, $key, 1, 1, 'L', 0, '', 1);

          $pdf->SetFont('helvetica', 'B', 10);
          $pdf->SetXY(152, $y);
          $pdf->Cell(50, 5, $value, 1, 1, 'C', 0, '', 1);
          $y += 5;
      }

      $y += 5;
      foreach ($lv_cmp[2] as $key => $value) {
          $pdf->SetFont('helvetica', '', 8);
          $pdf->SetXY(112, $y);
          $pdf->Cell(40, 5, $key, 1, 1, 'L', 0, '', 1);

          $pdf->SetFont('helvetica', 'B', 10);
          $pdf->SetXY(152, $y);
          $pdf->Cell(50, 5, $value, 1, 1, 'C', 0, '', 1);
          $y += 5;
      }

      $pdf->SetFont('helvetica', 'B', 8);
      $pdf->SetXY(20, 80);
      $pdf->Cell(40, 5, 'Orden N°', 1, 1, 'L', 0, '', 1);
      $pdf->SetFont('helvetica', 'B', 10);
      $pdf->SetXY(60, 80);
      $pdf->Cell(50, 5, $vew_doc->getTagValue($vew_ste->cnssteatr, 'ATR_GRF'), 1, 1, 'L', 0, '', 1); // ORDEN N°- grafo
  }

 	// create new PDF document
  $pdf = new MYPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, PDF_PAGE_FORMAT, true, 'ISO-8859-1', false);
	$pdf->lv_usrcod=$vew_sec->usrcod;
  // set default monospaced font
  $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

  // set margins
  $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);
	$pdf->SetHeaderMargin(PDF_MARGIN_HEADER);
	$pdf->SetFooterMargin(PDF_MARGIN_FOOTER);

  // set auto page breaks
  $pdf->SetAutoPageBreak(TRUE, PDF_MARGIN_BOTTOM);

  // set image scale factor
  $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

	for($i=0; $i < $vew_msgqty; $i++){
    // ---------------------------------------------------------
    $pdf->AddPage('P');
		generarRotulo($pdf, $vew_ste, $vew_doc, $vew_bus, $vew_data);

  }
	// C U E R P O
	$pdf->setfont('Helvetica', '', 7);
	$lv_buffertbl= '<table border="1" cellspacing="0" cellpadding="1" width="100%"><thead>'.
								'<tr style="background-color:#ffcc99;">'.
									'<th rowspan="2" align="center" width="40">RUBRO</th>'.
									'<th rowspan="2" align="center" width="40">ITEM</th>'.
    							'<th rowspan="2" align="center" width="200">CONCEPTO</th>'.
									'<th colspan="2" rowspan="2" align="center" width="75">UNID. REAL</th>'.
									'<th colspan="3" align="center" width="183">PRECIO</th>'.
                  '<th rowspan="2" align="center" width="80">TOTAL</th>'.
									'<th rowspan="2" align="center" width="30">REC</th>'.
								'</tr>'.
    						'<tr style="background-color:#ffcc99;">'.
                  '<th align="center" width="74">BAREMO</th>'.
                  '<th align="center" width="35">COEF</th>'.
                  '<th align="center" width="74">UNITARIO</th>'.
    						'</tr></thead><tbody>';

  $lv_dat=$vew_data->cnssteevtdoc[0]['steevtdocatr']??'';
  $lv_dat =json_decode(utf8_encode(html_entity_decode($lv_dat)),true);
	$lv_tot=0;
	$lv_cnt=0;
	$lv_cnttotrow=0;
	$lv_cnttot=0;
	$lv_buffer='';
  foreach( $lv_dat['CRT_TSK'] as $lv_rowste ){
      if(($lv_rowste['tskcod']??'')!=''){
        $lv_tot=$lv_tot+($lv_rowste['tsktot']??0);
        $lv_cnttotrow++;
      }
  }
  foreach( $lv_dat['CRT_TSK'] as $lv_rowste ){
    if(($lv_rowste['tskcod']??'')!=''){
      if(($lv_rowste['tskcodext']??'')!=''){
    		// Dividir la cadena por puntos 
        $lv_tskcodext_arr = explode('.', $lv_rowste['tskcodext']); 
        // Unir las primeras tres partes 
        $lv_rowste['tskcodext1'] = implode('.', array_slice($lv_tskcodext_arr, 0, 3)); 
        // Unir las últimas dos partes 
        $lv_rowste['tskcodext2'] = implode('.', array_slice($lv_tskcodext_arr, 3));
      }
      $lv_buffer.= '<tr style="font-size:11px; height: 30px;">'.
                      '<td align="center" width="40" style="height: 30px;">'.($lv_rowste['tskcodext1']??'').'</td>'.
                      '<td align="center" width="40" style="height: 30px;">'.($lv_rowste['tskcodext2']??'').'</td>'.
        							'<td width="200" >'.htmlentities(mb_convert_encoding(($lv_rowste['tsktxt']??''),'UTF-8','iso-8859-1')).'</td>'.
        							'<td align="right" width="45">'.number_format((float)($lv_rowste['tskqty']??''),3,',','.').'</td>'.
                      '<td align="right" width="30">'.htmlentities(mb_convert_encoding(($lv_rowste['tskuntcod']??''),'UTF-8','iso-8859-1')) .'</td>'.
        							'<td align="right" width="74">'.number_format((float)($lv_rowste['tskprcbse']??''),2,',','.').'</td>'.
                      '<td align="right" width="35">'.number_format((float)($lv_rowste['tskcof']??''),3,',','.').'</td>'.
                      '<td align="right" width="74">'.number_format((float)($lv_rowste['tskprc']??''),2,',','.').'</td>'.
                      '<td align="right" width="80">'.number_format((float)($lv_rowste['tsktot']??''),2,',','.').'</td>'.
                      '<td align="right" width="30">'.number_format((float)($lv_rowste['tskrec']??''),2,',','.').'</td>'.
                    '</tr>';
      $lv_cnt++;
      $lv_cnttot++;
    }
    // Verificar si el contador ha llegado a 13
    if ($lv_cnt == 13 || $lv_cnttot==$lv_cnttotrow) {
        $pdf->setfont('Helvetica', '', 7);
      	$lv_buffer =$lv_buffertbl.$lv_buffer.'</tbody></table>'; // Cerrar la tabla actual
				
        // Escribir el contenido en el PDF
        $pdf->setxy(20, 95);
        $pdf->writeHTML($lv_buffer);
				$lv_buffer='';
      
        // Total
        $pdf->setxy(20,-58);$pdf->SetFillColor(255, 204, 153); $pdf->Cell(180, 5, '', 1, 0, 'L',true);
        $pdf->SetFillColor(255, 255, 255);
        $pdf->SetFont('helvetica', 'B', 8);
        $pdf->text(100, $pdf->getY()+1, 'TOTAL' );
        $pdf->text( 170,$pdf->getY(),number_format((float)($lv_tot),2,',','.'));	
        
      	$lv_cnt=0; 
      	if($lv_cnttot!=$lv_cnttotrow){
          // Agregar una nueva página
          $pdf->AddPage('P');
          generarRotulo($pdf, $vew_ste, $vew_doc, $vew_bus, $vew_data);
        }
    }
  }
	$lv_flenme='CERTIFICADO - T'.$vew_ste->stecod.' - '.$vew_data->steevtcod.'.pdf';

  // Establecer los encabezados
  header('Content-Type: application/pdf');
  header('Content-Disposition: inline; filename="' . $lv_flenme . '"');
  header('Cache-Control: private, max-age=0, must-revalidate');
  header('Pragma: public');

	$pdf->setTitle($lv_flenme);
  echo $pdf->Output($lv_flenme, 'D');	
?>