/*
 * Detalle adicional de categorías.
 */
$lv_catlst=$vew_data->hltcatvallst;
if (isset($lv_catlst) &&is_array($lv_catlst)) {
    $lv_detalle = '';
    foreach ($lv_catlst as $lv_row) {
        $lv_texto = $lv_row;//isset($lv_row['hltcatvaltxt'])? trim($lv_row['hltcatvaltxt']): '';
        if ($lv_texto !== '') {
            $lv_detalle .= '- ' . $lv_texto . "\n";
        }
    }

    if ($lv_detalle !== '') {
        $pdf->SetFont('helvetica', '', 12);
        $pdf->SetXY(55, 138);
        $pdf->MultiCell(187,7,trim($lv_detalle),0,'C',false,1);
    }
}

