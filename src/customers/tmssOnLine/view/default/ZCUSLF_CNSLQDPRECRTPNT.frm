	// Extend the TCPDF class to create custom Header and Footer
if (!class_exists('MYCRTPDF')) {
	class MYCRTPDF extends TCPDF {
    public $lv_usrcod;
    public function Header() {
			$this->Image(
        '@' . base64_decode(''),
        14,
        3,      
        30,      
        0,      
        'PNG'   
      );
			$this->setfont('helvetica', 'B', 10);
      $this->setxy(20,23); $this->Cell(180, 5, 'NG-02-C PROPUESTA DE CERTIFICACION', 1, 0, 'C');
	
    }
		
    public function Footer() {
      
      $this->SetFont('helvetica', 'B', 8);
      $this->SetY(-70);

      $this->text(40,  $this->getY(), 'CONTRATISTA');
      $this->text(95,  $this->getY(), 'SUPERVISOR EDENOR');
      $this->text(149, $this->getY(), 'JEFE DEPARTAMENTO EDENOR');

      // Aclaración firmas
      $this->SetFont('courier', '', 9);
      $this->SetY(-66);

      $this->text(27,  $this->getY(), 'Firma, aclaracion y Fecha');
      $this->text(86,  $this->getY(), 'Firma, aclaracion y Fecha');
      $this->text(148, $this->getY(), 'Firma, aclaracion y Fecha');

      $this->Image(
        '@' . base64_decode(''),
        30,
        $this->GetY()+10,      
        40,      
        0,      
        'PNG'   
      );
      $this->SetY(-24);
			$this->SetFont('helvetica', 'B', 8);
			$this->text(20, $this->getY(), 'NG-02-C  PROPUESTA DE CERTIFICACIÓN  -  Revisión N° 9' );
			$this->text(20, $this->getY()+4, 'Fecha de Actualización 24/02/2022' );
			$this->text(20, $this->getY()+4, 'Fecha Edición: 30/03/2007');

      $this->SetY(-4);
			$this->SetFont('helvetica', '', 8);
			$this->text(180, $this->getY(), 'Pagina '.$this->getAliasNumPage().' de '.$this->getAliasNbPages() );
    }
	}
}
if (!function_exists('generarRotulocnslqd')) { 
  function generarRotulocnslqd($pdf, $vew_doc,$lp_pec, $vew_bus, $vew_data) {
    
      // Supervisor SS (valor fijo en este caso)
      $lv_supsuptxt = 'BAEZ CLAUDIO JAVIER';

      // Añadir textos al rótulo
      $pdf->setfont('helvetica', 'B', 9);
      $pdf->text(20, 35, 'ZONA:');   
      $pdf->text(32, 35, mb_convert_encoding($vew_data->lndtwntxt, 'UTF-8', 'iso-8859-1') ?? '');
      	
      // Formulario
      $lv_cmp[0] = array(
          'CONTRATISTA' => $vew_bus->bustxt,
          'DIRECCION' => mb_convert_encoding($vew_bus->adr->adrstr, 'UTF-8', 'iso-8859-1').' '.$vew_bus->adr->adrstrnum,
          'N° DE CUIT' => ($vew_bus->tax->idttyptxt ?? '') == 'CUIT' ? $vew_bus->tax->taxcod : '',
          'N° DE CONTRATO' => '9000008061',
          'SUPERVISOR CONTRATISTA' => $lv_supsuptxt
      );
      $lv_cmp[1] = array(
          'Nº DE HOJA DE ENTRADA' => '',
          'Nº DE CERTIFICACION' => '',
          'FECHA CERTIFICACION' => $vew_data->ctedte->format('d/m/Y'),
          'N° DE PEC' => $lp_pec,
      );
      $lv_cmp[2] = array(
          'CENTRO DE COSTO' => '',
          'Nº DE PEDIDO' => mb_convert_encoding($vew_data->cnslqdcodext, 'UTF-8', 'iso-8859-1'),
          'PARTIDO' => '',
          'CUENTA DE APLICACIÓN' => ''
      );

      $y = 45;
      foreach ($lv_cmp[0] as $key => $value) {
          $pdf->SetFont('helvetica', '', 8);
          $pdf->SetXY(20, $y);
          $pdf->Cell(40, 5, $key, 1, 1, 'L', 0, '', 1);

          $pdf->SetFont('helvetica', 'B', 10);
          $pdf->SetXY(60, $y);
          $pdf->Cell(50, 5, $value, 1, 1, 'L', 0, '', 1);
          $y += 5;
      }

      $y = 45;
      foreach ($lv_cmp[1] as $key => $value) {
          $pdf->SetFont('helvetica', '', 8);
          $pdf->SetXY(112, $y);
          $pdf->Cell(40, 5, $key, 1, 1, 'L', 0, '', 1);

          $pdf->SetFont('helvetica', 'B', 10);
          $pdf->SetXY(152, $y);
          $pdf->Cell(50, 5, $value, 1, 1, 'C', 0, '', 1);
          $y += 5;
      }

      foreach ($lv_cmp[2] as $key => $value) {
          $pdf->SetFont('helvetica', '', 8);
          $pdf->SetXY(112, $y);
          $pdf->Cell(40, 5, $key, 1, 1, 'L', 0, '', 1);

          $pdf->SetFont('helvetica', 'B', 10);
          $pdf->SetXY(152, $y);
          $pdf->Cell(50, 5, $value, 1, 1, 'C', 0, '', 1);
          $y += 5;
      }

  
      $pdf->SetFont('helvetica', 'B', 8);
      $pdf->SetXY(20, 80);
      $pdf->Cell(40, 5, 'Orden N°', 1, 1, 'L', 0, '', 1);
      $pdf->SetFont('helvetica', 'B', 10);
      $pdf->SetXY(60, 80);
      $pdf->Cell(50, 5, '', 1, 1, 'L', 0, '', 1);

      $pdf->text(23, 85, '');
  }
}

  // create new PDF document
  $pdf = new MYCRTPDF(PDF_PAGE_ORIENTATION, PDF_UNIT, PDF_PAGE_FORMAT, true, 'ISO-8859-1', false);
	$pdf->lv_usrcod=$vew_sec->usrcod;
  // set default monospaced font
  $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

  // set margins
  $pdf->SetMargins(PDF_MARGIN_LEFT, PDF_MARGIN_TOP, PDF_MARGIN_RIGHT);
	$pdf->SetHeaderMargin(PDF_MARGIN_HEADER);
	$pdf->SetFooterMargin(PDF_MARGIN_FOOTER);

  // set auto page breaks
  $pdf->SetAutoPageBreak(TRUE, PDF_MARGIN_BOTTOM);

  // set image scale factor
  $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);

	$lv_dat = is_array($vew_data->cnslqddochie) ? $vew_data->cnslqddochie : (is_array($vew_data->cnslqddoc) ? $vew_data->cnslqddoc : array());
	foreach ($lv_dat as $lv_pec => $lv_grp) {
    $pdf->AddPage('P');
		generarRotulocnslqd($pdf, $vew_doc,$lv_pec, $vew_bus, $vew_data);
  
    // C U E R P O
    $pdf->setfont('Helvetica', '', 7);
    $lv_buffertbl= '<table border="1" cellspacing="0" cellpadding="1" width="100%"><thead>'.
                  '<tr style="background-color:#e9e9e9;">'.
                    '<th rowspan="2" align="center" width="40">RUBRO</th>'.
                    '<th rowspan="2" align="center" width="65">ITEM</th>'.
                    '<th rowspan="2" align="center" width="210">CONCEPTO</th>'.
                    '<th rowspan="2" align="center" width="50">UNID. REAL</th>'.
                    '<th colspan="3" align="center" width="165">PRECIO</th>'.
                    '<th rowspan="2" align="center" width="67">IMPORTE</th>'.
                    '<th rowspan="2" align="center" width="48">RECARGO</th>'.
                  '</tr>'.
                  '<tr style="background-color:#e9e9e9;">'.
                    '<th align="center" width="65">BAREMO</th>'.
                    '<th align="center" width="35">COEF</th>'.
                    '<th align="center" width="65">UNITARIO</th>'.
                  '</tr></thead><tbody>';

    $lv_dat= $lv_grp ?? array();
    $lv_tot=0;
    $lv_cnttot=0;
    $lv_cnttotrow = count($lv_dat);
    $lv_cnt = 0;
    $lv_buffer='';
    foreach( $lv_dat as $lv_rowste ){
      if(($lv_rowste['cnstskcod']??'')!=''){
        $val_row = (float)($lv_rowste['cnslqddoctot'] ?? 0);
        $lv_tot += $val_row;
        $lv_buffer.= '<tr style="font-size:11px; height: 30px;">'.
                        '<td align="center" width="40" style="height: 30px;"></td>'.
                        '<td align="center" width="65" style="height: 30px;">'.($lv_rowste['cnstskcodext']??'').'</td>'.
                        '<td width="210" >'.(is_array($vew_data->cnslqddochie) ? htmlentities($lv_rowste['cnstsktxt']??'') : $lv_rowste['cnstsktxt']??'' ).'</td>'.
                        '<td align="center" width="50">'.number_format((float)($lv_rowste['cnslqddocqty']??''),0,',','.').'</td>'.
                        '<td align="right" width="65">'.number_format((float)($lv_rowste['cnslqddocbar']??''),2,',','.').'</td>'.
                        '<td align="right" width="35">'.number_format((float)($lv_rowste['cnslqddoccof']??''),3,',','.').'</td>'.
                        '<td align="right" width="65">'.number_format((float)($lv_rowste['cnslqddocprc']??''),2,',','.').'</td>'.
                        '<td align="right" width="67">'.number_format((float)($lv_rowste['cnslqddoctot']??''),2,',','.').'</td>'.
                        '<td align="right" width="48">'.number_format((float)($lv_rowste['cnslqddocrec']??''),2,',','.').'</td>'.
                      '</tr>';
      $lv_cnt++;
      $lv_cnttot++;
      }
      // Verificar si el contador ha llegado a 13
      if ($lv_cnt == 13 || $lv_cnttot==$lv_cnttotrow) {
          while ($lv_cnt < 13 ) {
              $lv_buffer .= '<tr style="font-size:11px;height: 30px;"><td width="40" style="height: 30px;"></td><td width="65" style="height: 30px;"></td><td width="210"></td><td width="50"></td><td width="65"></td><td width="35"></td><td width="65"></td><td width="67"></td><td width="48"></td></tr>';
              $lv_cnt++;
          }

          $pdf->setfont('Helvetica','', 7);
          $lv_buffer =$lv_buffertbl.$lv_buffer.'</tbody></table>'; // Cerrar la tabla actual

          // Escribir el contenido en el PDF
          $pdf->setxy(20, 95);
          $pdf->writeHTML($lv_buffer);
          $lv_buffer='';

          $pdf->setxy(20,-78);$pdf->SetFillColor(233, 233, 233); $pdf->Cell(180, 5, '', 1, 0, 'L',true);
          $pdf->SetFillColor(255, 255, 255);
          $pdf->SetFont('helvetica', 'B', 8);
          $pdf->text(100, $pdf->getY()+1, 'TOTAL' );
          $pdf->text( 170,$pdf->getY(),number_format((float)($lv_tot),2,',','.'));	

          $lv_cnt=0; 
          if($lv_cnttot!=$lv_cnttotrow){
            // Agregar una nueva página
            $pdf->AddPage('P');
            generarRotulocnslqd($pdf, $vew_doc,$lv_pec, $vew_bus, $vew_data);
          }
      }
    }
  }
	$lv_flenme='PROPUESTA DE CERTIFICACION.pdf';

	$pdf->setTitle($lv_flenme);
  $pdf->Output($lv_flenme);
?>